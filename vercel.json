{
  "version": 2,
  "builds": [
    {
      "src": "api/submit-lead.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/submit-lead",
      "dest": "api/submit-lead.js"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}

