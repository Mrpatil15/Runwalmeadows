# ─────────────────────────────────────────────────
#  RUNWAL MEADOWS – Backend Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# Port (default 3000)
PORT=3000

# ── Email (Gmail recommended) ──────────────────
# 1. Go to myaccount.google.com → Security → App Passwords
# 2. Create an App Password for "Mail"
# 3. Paste it below (not your regular Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-digit-app-password

# Where leads go (your agency email)
LEAD_EMAIL=heawen@runwalmeadows.info

# ── Leads Dashboard Password ──────────────────
# Visit  http://localhost:3000/leads?key=YOUR_KEY  to view all leads
ADMIN_KEY=heawen2024

# ── Sender name shown in emails ───────────────
FROM_NAME=Runwal Meadows – Heawen Property
